sources/

# Intermediate pipeline artifacts (Docling JSON, summarize jobs)
.kb-work/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# SDD scratch
.superpowers/
