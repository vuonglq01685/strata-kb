sources/
.kb/
.env

# Intermediate pipeline artifacts (Docling JSON, summarize jobs)
.kb-work/

# Python
__pycache__/
*.pyc
.venv/
.venv
venv/
.venv-artifact/
.venv-runner/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# SDD scratch
.superpowers/

# Git worktrees (SDD isolation)
.worktrees/

# Harness-managed agent worktrees (parallel SDD tasks)
.claude/worktrees/
