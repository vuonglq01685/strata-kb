STRATA_KB_HTTP_TOKEN=change-me
# Host names /mcp answers to behind a reverse proxy, comma-separated (e.g. kb.example.com). Empty = localhost only.
STRATA_KB_ALLOWED_HOSTS=
# hub-sync opens the kb-code-sync issue with the intake GitHub App (STRATA_KB_GH_APP_ID / STRATA_KB_GH_APP_KEY), which then needs issues: write, pull_requests: read and contents: read on the hub repo.
# Only used when the App is not configured: a token with the same three permissions on the hub repo (issues: write, pull_requests: read, contents: read).
STRATA_KB_GH_TOKEN=
# Seconds between hub-sync scans (minimum 60).
STRATA_KB_CODE_SYNC_INTERVAL=86400
# Hub web UI accounts live in .kb-auth/ (never commit it). Create the first admin with
#   docker compose exec hub kb user add <name> --role admin
# or uncomment both lines (the hash comes from `kb user hash`; a plaintext password is never accepted).
# They apply only while no account exists.
# STRATA_KB_BOOTSTRAP_ADMIN=admin
# STRATA_KB_BOOTSTRAP_PASSWORD_HASH=
