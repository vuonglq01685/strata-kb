STRATA_KB_HTTP_TOKEN=change-me
# hub-sync opens the kb-code-sync issue with the intake GitHub App (STRATA_KB_GH_APP_ID / STRATA_KB_GH_APP_KEY), which then needs the issues: write permission.
# Only used when the App is not configured: a token with issues: write on the hub repo.
STRATA_KB_GH_TOKEN=
# Seconds between hub-sync scans (minimum 60).
STRATA_KB_CODE_SYNC_INTERVAL=86400
