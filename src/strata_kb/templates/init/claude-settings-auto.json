{
  "permissions": {
    "allow": [
      "Bash(kb *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push origin HEAD*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Edit",
      "Write",
      "Read",
      "mcp__strata-kb__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * main)",
      "Bash(git push origin main*)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf /*)",
      "Edit(.claude/settings.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kb usage ingest-transcript --hook-stdin",
            "timeout": 30,
            "statusMessage": "Recording token usage..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kb usage ingest-transcript --hook-stdin",
            "timeout": 30,
            "statusMessage": "Recording token usage..."
          }
        ]
      }
    ]
  }
}
