{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull origin *)",
      "Bash(git switch -c *)",
      "Bash(git switch auto/*)",
      "Bash(git switch fix/*)",
      "Bash(git switch hotfix/*)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push)",
      "Bash(gh pr *)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh run rerun*)",
      "Bash(gh run list*)",
      "Edit",
      "Write",
      "Read",
      "mcp__strata-kb__*",
      "Bash(kb mission *)",
      "Bash(kb ticket *)",
      "Bash(kb publish*)",
      "Bash(kb svc *)",
      "Bash(kb impl *)",
      "Bash(kb plan *)",
      "Bash(kb pr *)",
      "Bash(kb resolve *)",
      "Bash(kb context *)",
      "Bash(kb query *)",
      "Bash(kb doctor*)",
      "Bash(kb code-ingest*)",
      "Bash(kb usage *)",
      "Bash(kb auto status*)"
    ],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git checkout main*)",
      "Bash(git checkout master*)",
      "Bash(git switch main*)",
      "Bash(git switch master*)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete *)",
      "Bash(gh run delete*)",
      "Bash(kb init*)",
      "Bash(kb auto on*)",
      "Bash(kb auto off*)",
      "Bash(kb auto run*)",
      "Bash(rm -rf /*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.json)",
      "Write(.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kb usage ingest-transcript --hook-stdin",
            "timeout": 30,
            "statusMessage": "Recording token usage..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kb usage ingest-transcript --hook-stdin",
            "timeout": 30,
            "statusMessage": "Recording token usage..."
          }
        ]
      }
    ]
  }
}
